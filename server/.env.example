# BankShield Server Configuration Template
# Copy this file to .env and replace placeholders with your actual values

# Runtime Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (e.g., Neon Postgres or local)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bankshield

# JWT Authentication Secrets (Generate secure random 64-char strings)
JWT_SECRET=your_super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_change_in_production

# ML Microservice Endpoint & Timeout
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=800

# Frontend Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Fraud Detection Thresholds (0 - 100 scale)
FRAUD_BLOCK_THRESHOLD=80
FRAUD_FLAG_THRESHOLD=30
FRAUD_ALERT_THRESHOLD=30

# API Rate Limiter
API_RATE_LIMIT_MAX=5000
